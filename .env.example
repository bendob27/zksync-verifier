# Copy to .env and fill in. Never commit .env.
#
# For a DEMO instance set DEMO_MODE=true and supply only SESSION_SECRET and
# DASHBOARD_PASSWORD. It serves invented data, contacts nothing external, and
# publishes its own login password. Never enable it where real data is reachable.
# DEMO_MODE=
# The server validates all of these at boot and exits with a list of what's missing.

# --- Required ---

# Shared password for the dashboard login gate.
DASHBOARD_PASSWORD=

# HMAC key used to sign session cookies. Generate with: openssl rand -hex 32
# Must be stable across restarts, or every session is invalidated on deploy.
SESSION_SECRET=

# Google service account JSON, as a single line. The account needs read access
# to both spreadsheets below.
GOOGLE_CREDENTIALS=

# OpenRouter API key, used for grant matching and screenshot OCR.
OPENROUTER_API_KEY=

# Spreadsheet ID of the unlock schedule (the authoritative grant record).
TOKEN_MODEL_SHEET_ID=

# Spreadsheet ID of the payment history, used for duplicate and cumulative checks.
FINANCE_WORKBOOK_SHEET_ID=

# --- Optional ---

# Allowed browser origin. Required in production: without it CORS reflects any
# origin while credentials are enabled.
# CORS_ORIGIN=

# API server port. Defaults to 8080.
# PORT=

# Vite dev server port (frontend). Defaults to 5173.
# WEB_PORT=

# Where the Vite dev server proxies /api requests. Defaults to http://localhost:8080.
# API_PROXY_TARGET=

# Sub-path the dashboard is served under. Defaults to /.
# BASE_PATH=

# pino log level. Defaults to info.
# LOG_LEVEL=

# OpenRouter model slug. Defaults to anthropic/claude-opus-4.6.
# Note the dot — 'claude-opus-4-6' is not a valid slug and every request 404s.
# OPENROUTER_MODEL=

# Worksheet tab names, if they differ from the defaults in lib/constants.ts
# ('Unlock Schedules', 'Vesting Schedules', 'Cash Flows').
# UNLOCK_SCHEDULES_TAB=
# VESTING_SCHEDULES_TAB=
# CASH_FLOWS_TAB=

# Header text of the grant identifier column in the unlock schedule.
# Defaults to 'Grant ID'. 'Grant ID' and 'GrantID' are always tried as fallbacks.
# GRANT_ID_HEADER=
